@model IEnumerable<feedback.Models.Feedback>

@{
	ViewData["Title"] = "Миний санал хүсэлтүүд";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered">
	<thead>
		<tr>
			<th>Гарчиг</th>
			<th>Мессеж</th>
			<th>Огноо</th>
			<th>Админ хариу</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Title</td>
				<td>@item.Message</td>
				<td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
				<td>@(string.IsNullOrEmpty(item.AdminReply) ? "Хариу өгөөгүй" : item.AdminReply)</td>
			</tr>
		}
	</tbody>
</table>
